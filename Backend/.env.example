# Django Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here

# Database Configuration
DB_NAME=elearning_db
DB_USER=elearning_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Email Configuration
DEFAULT_FROM_EMAIL=noreply@elearning.com

# Frontend URLs
FRONTEND_URL=http://localhost:3000
DEPLOYED_FRONTEND_URL=https://your-frontend-domain.com

# Backend URLs
BACKEND_URL=http://localhost:8000
DEPLOYED_BACKEND_URL=https://your-backend-domain.com

# Allowed Hosts (comma-separated, no spaces)
# For development: localhost,127.0.0.1
# For production: your-domain.com,www.your-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# AI Tutor Configuration
# Choose 'gemini' or 'openai' as your AI provider
AI_PROVIDER=gemini

# Gemini API Key (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# AI Tutor Settings (optional - defaults are set in settings.py)
AI_TUTOR_ENABLE_STREAMING=False

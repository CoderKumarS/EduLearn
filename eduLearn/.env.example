# API Configuration
# Copy this file to .env and update with your actual values

# Base API URL - Update with your backend server address
# For local development on physical device, use your computer's IP address
# For emulator, you can use localhost or 10.0.2.2 (Android) or localhost (iOS)
EXPO_PUBLIC_API_BASE_URL=http://YOUR_IP_ADDRESS:8000/api

# Auth API URL - Usually the same as base URL with /auth path
EXPO_PUBLIC_API_AUTH_URL=http://YOUR_IP_ADDRESS:8000/api/auth

# Example configurations:
# Physical Device: http://192.168.1.100:8000/api
# Android Emulator: http://10.0.2.2:8000/api
# iOS Simulator: http://localhost:8000/api
